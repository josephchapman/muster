{
  "name": "Muster",
  "image": "ubuntu:resolute",
  "remoteUser": "muster",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "features": {
    "./src/000_utils/": {},
    "./src/argocd_cli/": {},
    "./src/docker/": {},
    "./src/kubectl/": {},
    "./src/helm/": {},
    "./src/skaffold/": {},
    "./src/vault/": {},
    "./src/zzz_user/": {
      "username": "muster",
      "docker_group": true
    }
  },
  "runArgs": [
    "--network=host" // required for kubectl to work properly with the host's kubeconfig
  ],
  "mounts": [
    "type=bind,source=${env:HOME}/.kube/config,target=/home/muster/.kube/config"
  ]
}